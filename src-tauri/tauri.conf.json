{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inVectus",
  "version": "0.2.0",
  "identifier": "app.invectus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p invectus-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inVectus",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "files": {
        "MacOS/invectus": "../target/release/invectus"
      }
    }
  }
}
