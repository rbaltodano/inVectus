+    /// Like [`Connection::open_from_raw`], but the connection takes ownership of `raw`: it is
+    /// closed when this connection and every connection cloned from it are dropped.
+    ///
+    /// # Safety
+    ///
+    /// `raw` must be a valid database handle that nothing else closes.
+    // invectus patch: lets a database opened through the C API (to install an encryption
+    // module before use) share duckdb-rs's reference-counted ownership, so no clone can
+    // outlive it. See third_party/README.md.
+    #[inline]
+    pub unsafe fn open_from_raw_owned(raw: ffi::duckdb_database) -> Result<Self> {
+        unsafe { InnerConnection::new_from_raw_db(raw, true) }.map(|db| Self {
+            db: RefCell::new(db),
+            cache: StatementCache::with_capacity(STATEMENT_CACHE_DEFAULT_CAPACITY),
+            path: None,
+        })
+    }
+
